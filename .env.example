DATABASE_URL="postgresql://user:password@localhost:5432/coachbrain?schema=public"
# Only needed with a pooled provider (Supabase, PgBouncer, etc.) where DATABASE_URL
# is the pooled connection string — DIRECT_URL must be the direct (non-pooled) one.
# Same value as DATABASE_URL is fine for a plain, unpooled Postgres instance.
DIRECT_URL="postgresql://user:password@localhost:5432/coachbrain?schema=public"

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Free Gemini API key from https://aistudio.google.com/apikey — no credit card
# required. Powers every AI feature (free tier: 250 requests/day, plenty for
# early validation). Note: on the free tier Google may use your prompts to
# improve their models — fine for testing with yourself/trusted design
# partners, worth revisiting before onboarding many external coaches with
# sensitive athlete data.
GEMINI_API_KEY=""

# Optional model overrides (see src/lib/ai-model.ts) — both default to
# gemini-3.6-flash if unset, so leaving these out changes nothing. Set
# GEMINI_MODEL_STRONG to a higher-capability model once one is confirmed
# available on your account to raise the quality of the calls that actually
# decide something for the coach (Next Best Action, bottleneck diagnosis,
# performance level, weekly plan, competition/evaluation analysis, chat).
# GEMINI_MODEL_FAST=""
# GEMINI_MODEL_STRONG=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe secret key (https://dashboard.stripe.com/apikeys) and webhook signing
# secret (https://dashboard.stripe.com/webhooks, endpoint /api/webhooks/stripe).
# Leave unset to see the Payments section in "online payments not configured"
# state — offline (cash/transfer) payments work fully without Stripe.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
