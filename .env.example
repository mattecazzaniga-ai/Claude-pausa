DATABASE_URL="postgresql://user:password@localhost:5432/coachbrain?schema=public"
# Only needed with a pooled provider (Supabase, PgBouncer, etc.) where DATABASE_URL
# is the pooled connection string — DIRECT_URL must be the direct (non-pooled) one.
# Same value as DATABASE_URL is fine for a plain, unpooled Postgres instance.
DIRECT_URL="postgresql://user:password@localhost:5432/coachbrain?schema=public"

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API key (console.anthropic.com) — powers note extraction and athlete
# summaries. This is a separate, pay-per-use API key, NOT a Claude Pro/Max chat
# subscription — those don't grant API access. Cost is small: a short coaching
# note costs a fraction of a cent per extraction call.
ANTHROPIC_API_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
