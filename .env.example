DATABASE_URL="postgresql://user:password@localhost:5432/internet_wall?schema=public"
# Only needed with a pooled provider (Supabase, PgBouncer, etc.) where DATABASE_URL
# is the pooled connection string — DIRECT_URL must be the direct (non-pooled) one.
# Same value as DATABASE_URL is fine for a plain, unpooled Postgres instance.
DIRECT_URL="postgresql://user:password@localhost:5432/internet_wall?schema=public"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Stripe — leave blank in development to use the built-in mock checkout flow.
# Set both to enable real payments (also configure the webhook endpoint in the Stripe dashboard).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
