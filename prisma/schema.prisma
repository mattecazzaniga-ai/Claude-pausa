generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Sentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
  IMPROVING
}

model Coach {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  athletes     Athlete[]
  sessionNotes SessionNote[]
  analytics    AnalyticsEvent[]
}

/// A sport defines its own skill taxonomy. The product ships with one seeded
/// sport (beach tennis) but nothing in the schema or UI hardcodes it — adding
/// a new sport is just seeding new Sport/SkillCategory/Skill rows.
model Sport {
  id   String @id @default(cuid())
  slug String @unique
  name String

  skillCategories SkillCategory[]
  athletes        Athlete[]
}

model SkillCategory {
  id      String @id @default(cuid())
  sportId String
  name    String
  order   Int    @default(0)

  sport  Sport   @relation(fields: [sportId], references: [id])
  skills Skill[]

  @@index([sportId])
}

model Skill {
  id         String @id @default(cuid())
  categoryId String
  name       String
  order      Int    @default(0)

  category SkillCategory @relation(fields: [categoryId], references: [id])
  noteTags NoteTag[]

  @@index([categoryId])
}

model Athlete {
  id         String    @id @default(cuid())
  coachId    String
  sportId    String
  name       String
  birthYear  Int?
  level      String?
  objectives String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Cached AI output so the athlete page doesn't re-call the model on every
  // view — regenerated only when a new session note is added.
  aiSummary         String?
  aiPriorities      Json?
  aiSummaryUpdatedAt DateTime?

  coach        Coach         @relation(fields: [coachId], references: [id])
  sport        Sport         @relation(fields: [sportId], references: [id])
  sessionNotes SessionNote[]

  @@index([coachId])
}

model SessionNote {
  id          String   @id @default(cuid())
  athleteId   String
  coachId     String
  sessionDate DateTime @default(now())
  rawText     String
  aiProcessed Boolean  @default(false)
  createdAt   DateTime @default(now())

  athlete Athlete   @relation(fields: [athleteId], references: [id])
  coach   Coach     @relation(fields: [coachId], references: [id])
  tags    NoteTag[]

  @@index([athleteId])
}

model NoteTag {
  id            String    @id @default(cuid())
  sessionNoteId String
  skillId       String
  sentiment     Sentiment
  excerpt       String

  sessionNote SessionNote @relation(fields: [sessionNoteId], references: [id])
  skill       Skill       @relation(fields: [skillId], references: [id])

  @@index([sessionNoteId])
  @@index([skillId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  coachId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  coach Coach? @relation(fields: [coachId], references: [id])

  @@index([name])
  @@index([createdAt])
}
