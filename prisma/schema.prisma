generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Sentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
  IMPROVING
}

enum ExerciseCategory {
  TECHNICAL
  TACTICAL
  PHYSICAL
  COGNITIVE
  WARMUP
  COOLDOWN
  COMPETITIVE
}

enum ExerciseFormat {
  INDIVIDUAL
  PAIR
  SMALL_GROUP
  TEAM
  GAME
}

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}

enum ExerciseSource {
  COACH_CREATED
  AI_GENERATED
}

enum SessionBlockType {
  WARMUP
  TECHNICAL
  TACTICAL
  PHYSICAL
  GAME
  COOLDOWN
}

/// How a sport is actually played/trained — drives whether "create a team"
/// is even offered for a sport, and is part of the Sport Profile context fed
/// to every AI prompt so it never has to guess.
enum SportFormat {
  INDIVIDUAL
  PAIR
  TEAM
}

enum ObjectiveTermLength {
  SHORT
  MEDIUM
  LONG
}

/// Not every coaching objective can be reduced to a number ("become more
/// confident attacking the net") — see master prompt §13. Both are first-class.
enum ObjectiveKind {
  QUANTITATIVE
  QUALITATIVE
}

enum ObjectiveStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

/// Different sports/dimensions need different measurements — a universal
/// 1-10 scale would be meaningless for a stopwatch time or a pass-completion
/// percentage. See master prompt §7.
enum EvaluationScoreType {
  SCALE_1_5
  SCALE_1_10
  PERCENTAGE
  TIME_SECONDS
  DISTANCE_METERS
  REPETITIONS
  SUCCESS_RATE
  CUSTOM_NUMERIC
  QUALITATIVE
}

enum EvaluationKind {
  INITIAL
  PERIODIC
}

enum CompetitionType {
  TOURNAMENT
  MATCH
  CHAMPIONSHIP
  LEAGUE
  FRIENDLY
  OTHER
}

enum CompetitionResult {
  WIN
  LOSS
  DRAW
  NOT_RECORDED
}

enum CalendarEventType {
  TRAINING
  EVALUATION
  COMPETITION
  OTHER
}

enum CoachingActionType {
  TRAIN_SKILL
  CHANGE_EXERCISE
  PROGRESS_EXERCISE
  REGRESS_EXERCISE
  CHANGE_SESSION_STRUCTURE
  CHANGE_INTENSITY
  REASSESS
  CREATE_OBJECTIVE
  PREPARE_COMPETITION
  REVIEW_COMPETITION
  CHANGE_PRIORITY
  MAINTAIN_CURRENT_FOCUS
}

enum RecommendationConfidence {
  HIGH
  MEDIUM
  LOW
}

enum RecommendationFeedback {
  USEFUL
  NOT_USEFUL
}

model Coach {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  primarySportId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Set once at registration. A self-coaching account trains only itself:
  /// onboarding auto-provisions one Athlete (isSelf: true) for the coach's
  /// own name, and the dashboard/nav route straight to it instead of the
  /// multi-athlete/team management UI. Reuses the existing Coach/Athlete
  /// structure rather than a separate identity system — see Phase 2 scope.
  selfCoaching Boolean @default(false)

  primarySport        Sport?                   @relation(fields: [primarySportId], references: [id])
  athletes            Athlete[]
  sessionNotes        SessionNote[]
  exercises           Exercise[]
  trainingSessions    TrainingSession[]
  teams               Team[]
  goals               Objective[]
  evaluations         Evaluation[]
  customCriteria      EvaluationCriterion[]
  competitions        Competition[]
  calendarEvents      CalendarEvent[]
  recommendations     CoachingRecommendation[]
  analytics           AnalyticsEvent[]
  feedbackSignals     CoachFeedbackSignal[]
  offers              Offer[]
  purchases           Purchase[]
  passwordResetTokens PasswordResetToken[]
  checkins            AthleteCheckin[]
  metricValues        AthleteMetricValue[]

  /// Master prompt §10-11 (Coach Brain): a short, AI-synthesized list of
  /// observed preferences ({insight, evidenceCount, category}[]), refreshed
  /// periodically from feedbackSignals. Null until enough signals exist.
  learnedPreferences          Json?
  learnedPreferencesUpdatedAt DateTime?
}

/// Single-use, expiring token for the "forgot password" flow. Only a SHA-256
/// hash of the token is stored — never the raw value the coach clicks — so a
/// database leak alone can't be used to reset anyone's password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  coachId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
}

/// A sport defines its own skill taxonomy. The full list of common sports is
/// seeded up front (so onboarding never waits on AI), but the taxonomy itself
/// (SkillCategory/Skill) is generated on first real use — see lib/sport.ts —
/// rather than hand-authored for every sport. Adding a brand-new sport a
/// coach types in manually goes through the exact same path.
model Sport {
  id   String @id @default(cuid())
  slug String @unique
  name String

  // Sport Profile — generated once via AI on first real use (see
  // lib/sport.ts#ensureSportProfile, mirrors the lazy taxonomy pattern) and
  // then attached to every note/exercise/session AI prompt. Without this, the
  // AI only ever saw the sport's name, which risks structurally identical
  // output across sports with only labels swapped.
  formats            SportFormat[]
  environment        String?
  equipment          String?
  scoringSystem      String?
  keyRules           String?
  terminology        String?
  /// Roles/positions specific to this sport (e.g. goalkeeper/defender for
  /// football). Null/empty for sports with no positional structure.
  positions          String?
  movementPatterns   String?
  gameSituations     String?
  trainingMethods    String?
  commonProblems     String?
  progressions       String?
  safetyNotes        String?
  profileGeneratedAt DateTime?

  coaches            Coach[]
  skillCategories    SkillCategory[]
  metrics            SportMetric[]
  athletes           Athlete[]
  exercises          Exercise[]
  trainingSessions   TrainingSession[]
  teams              Team[]
  evaluationCriteria EvaluationCriterion[]
  competitions       Competition[]
  offers             Offer[]
}

enum SkillCategoryType {
  TECHNICAL
  TACTICAL
  PHYSICAL
  MENTAL
  OTHER
}

model SkillCategory {
  id      String            @id @default(cuid())
  sportId String
  name    String
  type    SkillCategoryType @default(OTHER)
  order   Int               @default(0)

  sport  Sport   @relation(fields: [sportId], references: [id])
  skills Skill[]

  @@index([sportId])
}

/// Sport-specific performance metrics (master prompt §22, "Smart Metrics
/// Engine") — e.g. pace/distance for running, first-serve % for tennis.
/// Generated lazily via AI on first real use, same pattern as the skill
/// taxonomy and Sport Profile. Deliberately just name/unit/description: no
/// invented thresholds or "scores" without a real statistical basis.
model SportMetric {
  id          String  @id @default(cuid())
  sportId     String
  name        String
  unit        String?
  description String?
  order       Int     @default(0)

  sport  Sport                @relation(fields: [sportId], references: [id])
  values AthleteMetricValue[]

  @@index([sportId])
}

/// Closes the loop on the Smart Metrics Engine (master prompt §22): Phase 1
/// only generated the metric *definitions* (name/unit/description) — this is
/// where a coach actually records an athlete's real value over time, so the
/// metric becomes a trend rather than a label nobody fills in.
model AthleteMetricValue {
  id            String   @id @default(cuid())
  athleteId     String
  coachId       String
  sportMetricId String
  value         Float
  recordedAt    DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  athlete     Athlete     @relation(fields: [athleteId], references: [id])
  coach       Coach       @relation(fields: [coachId], references: [id])
  sportMetric SportMetric @relation(fields: [sportMetricId], references: [id])

  @@index([athleteId, sportMetricId])
}

model Skill {
  id         String @id @default(cuid())
  categoryId String
  name       String
  order      Int    @default(0)

  category      SkillCategory   @relation(fields: [categoryId], references: [id])
  noteTags      NoteTag[]
  exerciseLinks ExerciseSkill[]

  @@index([categoryId])
}

model Athlete {
  id         String   @id @default(cuid())
  coachId    String
  sportId    String
  name       String
  birthYear  Int?
  level      String?
  objectives String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Cached AI output so the athlete page doesn't re-call the model on every
  // view — regenerated only when a new session note is added.
  aiSummary          String?
  aiPriorities       Json?
  aiSummaryUpdatedAt DateTime?

  /// True for the one Athlete record auto-created for a self-coaching Coach
  /// to represent themselves (see Coach.selfCoaching). Regular athletes a
  /// coach manages for other people are always false.
  isSelf Boolean @default(false)

  coach            Coach                    @relation(fields: [coachId], references: [id])
  sport            Sport                    @relation(fields: [sportId], references: [id])
  sessionNotes     SessionNote[]
  trainingSessions TrainingSession[]
  teamMemberships  TeamMember[]
  goals            Objective[]
  evaluations      Evaluation[]
  competitions     Competition[]
  calendarEvents   CalendarEvent[]
  recommendations  CoachingRecommendation[]
  purchases        Purchase[]
  feedbackSignals  CoachFeedbackSignal[]
  checkins         AthleteCheckin[]
  metricValues     AthleteMetricValue[]

  @@index([coachId])
}

/// A group of athletes trained together — distinct from Exercise/ Athlete
/// "individual/pair/small_group/team" FORMAT, which describes how a single
/// exercise is run. A Team is the standing roster a coach generates group
/// sessions for (see TrainingSession.teamId).
model Team {
  id        String   @id @default(cuid())
  coachId   String
  sportId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach            Coach                    @relation(fields: [coachId], references: [id])
  sport            Sport                    @relation(fields: [sportId], references: [id])
  members          TeamMember[]
  trainingSessions TrainingSession[]
  goals            Objective[]
  evaluations      Evaluation[]
  competitions     Competition[]
  calendarEvents   CalendarEvent[]
  recommendations  CoachingRecommendation[]
  feedbackSignals  CoachFeedbackSignal[]

  @@index([coachId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  athleteId String
  createdAt DateTime @default(now())

  team    Team    @relation(fields: [teamId], references: [id])
  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@unique([teamId, athleteId])
  @@index([athleteId])
}

model SessionNote {
  id          String   @id @default(cuid())
  athleteId   String
  coachId     String
  sessionDate DateTime @default(now())
  rawText     String
  aiProcessed Boolean  @default(false)
  createdAt   DateTime @default(now())

  athlete Athlete   @relation(fields: [athleteId], references: [id])
  coach   Coach     @relation(fields: [coachId], references: [id])
  tags    NoteTag[]

  @@index([athleteId])
}

model NoteTag {
  id            String    @id @default(cuid())
  sessionNoteId String
  skillId       String
  sentiment     Sentiment
  excerpt       String

  sessionNote SessionNote @relation(fields: [sessionNoteId], references: [id])
  skill       Skill       @relation(fields: [skillId], references: [id])

  @@index([sessionNoteId])
  @@index([skillId])
}

/// A coach's own exercise library — the core asset the AI session generator
/// draws from before it ever invents something new (see lib/session.ts).
model Exercise {
  id      String @id @default(cuid())
  coachId String
  sportId String
  name    String

  description     String?
  instructions    String?
  category        ExerciseCategory
  format          ExerciseFormat?
  difficulty      ExerciseDifficulty?
  durationMinutes Int?
  sets            Int?
  reps            Int?
  restSeconds     Int?
  intensity       String?
  equipment       String?
  minAthletes     Int?
  maxAthletes     Int?
  spaceRequired   String?
  coachingPoints  String?
  commonMistakes  String?
  progressionNote String?
  regressionNote  String?
  tags            String[]            @default([])
  /// Never let an AI-generated exercise be mistaken for the coach's own —
  /// see the AI knowledge priority rules in lib/session.ts.
  source          ExerciseSource      @default(COACH_CREATED)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  coach         Coach           @relation(fields: [coachId], references: [id])
  sport         Sport           @relation(fields: [sportId], references: [id])
  skills        ExerciseSkill[]
  sessionBlocks SessionBlock[]

  @@index([coachId])
  @@index([sportId])
}

model ExerciseSkill {
  id         String @id @default(cuid())
  exerciseId String
  skillId    String

  exercise Exercise @relation(fields: [exerciseId], references: [id])
  skill    Skill    @relation(fields: [skillId], references: [id])

  @@unique([exerciseId, skillId])
  @@index([skillId])
}

/// A generated (or manually built) training session: an ordered list of
/// blocks, each usually pointing at one Exercise from the coach's library.
/// Exactly one of athleteId/teamId is set — an individual session or a
/// whole-team session — enforced at the application layer (see
/// api/teams/[id]/sessions and api/athletes/[id]/sessions).
model TrainingSession {
  id              String   @id @default(cuid())
  coachId         String
  athleteId       String?
  teamId          String?
  objective       String?
  durationMinutes Int
  createdAt       DateTime @default(now())

  /// Master prompt §33 (minimum-effort session feedback), captured from
  /// Training Mode's end-of-session screen. Works uniformly for both
  /// athlete- and team-linked sessions; when there's an athlete, the note is
  /// also posted as a real SessionNote so it still feeds the existing AI
  /// analysis loop rather than being a dead end of its own.
  feedbackRating SessionFeedbackRating?
  feedbackNote   String?

  /// Set by the Adaptive Training Engine (lib/adaptive-training.ts) when the
  /// athlete's recent check-in/feedback data triggered an automatic load
  /// adjustment. Null whenever no adaptation applied — the common case, and
  /// the entire historical default for every session before this field.
  adaptationNote String?

  coach         Coach          @relation(fields: [coachId], references: [id])
  athlete       Athlete?       @relation(fields: [athleteId], references: [id])
  team          Team?          @relation(fields: [teamId], references: [id])
  sport         Sport?         @relation(fields: [sportId], references: [id])
  sportId       String?
  blocks        SessionBlock[]
  calendarEvent CalendarEvent?

  @@index([athleteId])
  @@index([teamId])
  @@index([coachId])
}

enum SessionFeedbackRating {
  EXCELLENT
  GOOD
  AVERAGE
  NEEDS_WORK
}

model SessionBlock {
  id                String           @id @default(cuid())
  trainingSessionId String
  order             Int
  type              SessionBlockType
  durationMinutes   Int
  exerciseId        String?
  /// Short "why this exercise" explanation shown to the coach — see spec §8.
  rationale         String?

  trainingSession TrainingSession @relation(fields: [trainingSessionId], references: [id])
  exercise        Exercise?       @relation(fields: [exerciseId], references: [id])

  @@index([trainingSessionId])
}

/// Master prompt §12-15. Exactly one of athleteId/teamId is set — same
/// pattern as TrainingSession. Baseline/target/current are stored as free
/// text since units vary wildly by dimension (%, seconds, a 1-10 score, or
/// a plain qualitative statement) — do not force a numeric-only model.
model Objective {
  id            String              @id @default(cuid())
  coachId       String
  athleteId     String?
  teamId        String?
  title         String
  description   String?
  termLength    ObjectiveTermLength
  kind          ObjectiveKind
  baselineValue String?
  targetValue   String?
  currentValue  String?
  unit          String?
  deadline      DateTime?
  status        ObjectiveStatus     @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  coach   Coach    @relation(fields: [coachId], references: [id])
  athlete Athlete? @relation(fields: [athleteId], references: [id])
  team    Team?    @relation(fields: [teamId], references: [id])

  @@index([coachId])
  @@index([athleteId])
  @@index([teamId])
}

/// A dimension an athlete/team gets scored on. coachId null = the sport's
/// shared default set, generated once via AI the same lazy way as the skill
/// taxonomy (see lib/evaluation.ts#ensureEvaluationCriteria); coachId set =
/// a coach's own custom criterion (master prompt §6), visible only to them.
model EvaluationCriterion {
  id          String              @id @default(cuid())
  sportId     String
  coachId     String?
  category    String
  name        String
  scoreType   EvaluationScoreType
  order       Int                 @default(0)
  targetLevel String?
  notes       String?
  createdAt   DateTime            @default(now())

  sport  Sport             @relation(fields: [sportId], references: [id])
  coach  Coach?            @relation(fields: [coachId], references: [id])
  scores EvaluationScore[]

  @@index([sportId])
  @@index([coachId])
}

/// One evaluation event (initial or periodic) for an athlete or team.
/// Exactly one of athleteId/teamId is set.
model Evaluation {
  id          String         @id @default(cuid())
  coachId     String
  athleteId   String?
  teamId      String?
  kind        EvaluationKind
  evaluatedAt DateTime       @default(now())
  notes       String?
  /// AI-generated comparison narrative vs the previous evaluation — see
  /// master prompt §10. Null until a periodic evaluation triggers analysis.
  aiAnalysis  String?
  createdAt   DateTime       @default(now())

  coach   Coach             @relation(fields: [coachId], references: [id])
  athlete Athlete?          @relation(fields: [athleteId], references: [id])
  team    Team?             @relation(fields: [teamId], references: [id])
  scores  EvaluationScore[]

  @@index([athleteId])
  @@index([teamId])
  @@index([coachId])
}

model EvaluationScore {
  id           String  @id @default(cuid())
  evaluationId String
  criterionId  String
  /// Stored as text regardless of scoreType (a percentage, a time, a
  /// qualitative note) — parsed/formatted for display per criterion.scoreType.
  value        String
  note         String?

  evaluation Evaluation          @relation(fields: [evaluationId], references: [id])
  criterion  EvaluationCriterion @relation(fields: [criterionId], references: [id])

  @@unique([evaluationId, criterionId])
  @@index([criterionId])
}

/// Master prompt §16-24 (Competitions/Tournaments/Matches). Exactly one of
/// athleteId/teamId is set, same pattern as TrainingSession/Objective. Result
/// fields stay empty until the coach records them after the event.
model Competition {
  id             String            @id @default(cuid())
  coachId        String
  athleteId      String?
  teamId         String?
  sportId        String
  name           String
  type           CompetitionType
  scheduledAt    DateTime
  location       String?
  opponent       String?
  importance     String?
  preNotes       String?
  postNotes      String?
  result         CompetitionResult @default(NOT_RECORDED)
  score          String?
  /// AI "what did we learn" analysis after the result is recorded — see
  /// lib/ai-competition.ts. Merged into the athlete's cached priorities the
  /// same way a periodic evaluation is, closing the Competition -> Training
  /// loop instead of results being dead data.
  aiPostAnalysis String?
  /// AI preparation advice generated on demand before the competition is
  /// played — master prompt §18/25. Purely advisory: unlike aiPostAnalysis,
  /// it never touches the athlete's cached priorities, since it's a
  /// forecast, not an observation.
  aiPreAnalysis  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  coach         Coach          @relation(fields: [coachId], references: [id])
  athlete       Athlete?       @relation(fields: [athleteId], references: [id])
  team          Team?          @relation(fields: [teamId], references: [id])
  sport         Sport          @relation(fields: [sportId], references: [id])
  calendarEvent CalendarEvent?

  @@index([coachId])
  @@index([athleteId])
  @@index([teamId])
}

/// Master prompt §15-24 (Coach Calendar). A planned event — distinct from a
/// TrainingSession, which is the generated *content* of a training. A
/// TRAINING event links to a TrainingSession once one is generated for it
/// (see api/calendar/[id]/generate-session); a COMPETITION event is
/// auto-created alongside its Competition so the coach never re-enters the
/// same date twice (master prompt §40).
model CalendarEvent {
  id                String            @id @default(cuid())
  coachId           String
  athleteId         String?
  teamId            String?
  competitionId     String?           @unique
  trainingSessionId String?           @unique
  type              CalendarEventType
  title             String
  startAt           DateTime
  endAt             DateTime
  location          String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  /// Master prompt PART 1 §11-15,38 (payments): the calendar event is the
  /// unit the coach actually schedules and opens, whether or not an AI
  /// session plan exists yet for it — so payment/credit lifecycle lives
  /// here, not on TrainingSession. "Mark Complete" transitions
  /// SCHEDULED -> COMPLETED and (if purchaseId is set) consumes one credit,
  /// exactly once (creditConsumedAt is the idempotency guard, §43).
  status           CalendarEventStatus @default(SCHEDULED)
  purchaseId       String?
  creditConsumedAt DateTime?

  coach           Coach            @relation(fields: [coachId], references: [id])
  athlete         Athlete?         @relation(fields: [athleteId], references: [id])
  team            Team?            @relation(fields: [teamId], references: [id])
  competition     Competition?     @relation(fields: [competitionId], references: [id])
  trainingSession TrainingSession? @relation(fields: [trainingSessionId], references: [id])
  purchase        Purchase?        @relation(fields: [purchaseId], references: [id])

  @@index([coachId])
  @@index([startAt])
  @@index([purchaseId])
}

enum CalendarEventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Master prompt §5-9,26-27 (Coaching Intelligence Engine): a generated
/// Next Best Action, stored with its evidence so the recommendation can be
/// explained later and the coach's 👍/👎 becomes a real signal instead of a
/// UI interaction that vanishes — the minimum provenance needed for future
/// Coach Brain learning, without building the full preference system yet.
model CoachingRecommendation {
  id                       String                   @id @default(cuid())
  coachId                  String
  athleteId                String?
  teamId                   String?
  actionType               CoachingActionType
  priorityLabel            String
  facts                    Json
  pattern                  String
  recommendation           String
  confidence               RecommendationConfidence
  missingData              Json?
  suggestedObjective       String?
  suggestedDurationMinutes Int?
  feedback                 RecommendationFeedback?
  feedbackReason           String?
  createdAt                DateTime                 @default(now())

  coach   Coach    @relation(fields: [coachId], references: [id])
  athlete Athlete? @relation(fields: [athleteId], references: [id])
  team    Team?    @relation(fields: [teamId], references: [id])

  @@index([coachId])
  @@index([athleteId])
  @@index([teamId])
}

enum CoachFeedbackSignalType {
  RECOMMENDATION_FEEDBACK
  SESSION_FEEDBACK
  EXERCISE_REPLACED
}

/// Master prompt §10-11 (Coach Brain foundation): an append-only log of every
/// moment a coach accepted, rejected, or adjusted something the AI proposed.
/// Coach Brain periodically reads this log to synthesize Coach.learnedPreferences —
/// the log itself is the ground truth and is never overwritten or pruned.
model CoachFeedbackSignal {
  id        String                  @id @default(cuid())
  coachId   String
  /// Which athlete/team this signal was observed from, when known — lets a
  /// coach "forget" everything the Coach Brain learned from one of them on
  /// deletion (see forgetAthleteMemory/forgetTeamMemory). Optional because
  /// not every signal is tied to one (and signals recorded before this field
  /// existed have no such link).
  athleteId String?
  teamId    String?
  type      CoachFeedbackSignalType
  summary   String
  detail    Json?
  createdAt DateTime                @default(now())

  coach   Coach    @relation(fields: [coachId], references: [id])
  athlete Athlete? @relation(fields: [athleteId], references: [id])
  team    Team?    @relation(fields: [teamId], references: [id])

  @@index([coachId, createdAt])
  @@index([athleteId])
  @@index([teamId])
}

enum CheckinFeeling {
  GREAT
  GOOD
  OK
  TIRED
  UNWELL
}

/// SELF_REPORTED: the athlete/coach filled the check-in form by hand.
/// WEARABLE_IMPORT: brought in via the CSV import (see lib/checkin-import.ts)
/// from a wearable app's exported data. Same AthleteCheckin timeline either
/// way — no separate "wearable" table (master prompt §32) — so the Adaptive
/// Training Engine and readiness trend already read both uniformly.
enum CheckinSource {
  SELF_REPORTED
  WEARABLE_IMPORT
}

/// Quick self-assessment an athlete (or a self-coaching Coach logging their
/// own training) fills in themselves — readiness before a session, perceived
/// exertion (Borg CR10, 0-10) after one, sleep and soreness. Deliberately
/// just these well-established fields, not an invented composite "score" —
/// see master prompt §22's warning against fabricating unvalidated metrics.
/// Fed into buildAthleteIntelligenceContext so Next Best Action can factor
/// in how the athlete actually feels, not just what the coach observed.
model AthleteCheckin {
  id               String          @id @default(cuid())
  athleteId        String
  coachId          String
  date             DateTime        @default(now())
  readiness        Int?
  rpe              Int?
  feeling          CheckinFeeling?
  sleepHours       Float?
  soreness         Int?
  notes            String?
  /// Wearable-only fields — null for a self-reported check-in that didn't
  /// come with device data.
  restingHeartRate Int?
  hrv              Float?
  steps            Int?
  source           CheckinSource   @default(SELF_REPORTED)
  createdAt        DateTime        @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id])
  coach   Coach   @relation(fields: [coachId], references: [id])

  @@index([athleteId, date])
}

enum OfferType {
  SINGLE_SESSION
  PACKAGE
  SUBSCRIPTION
}

enum OfferEligibility {
  INDIVIDUAL
  PAIR
  TEAM
}

enum PaymentMethod {
  ONLINE
  OFFLINE_CASH
  OFFLINE_TRANSFER
  OFFLINE_OTHER
}

enum PurchaseStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  OVERDUE
  REFUNDED
  CANCELLED
}

/// Master prompt PART 1 §4-8,21: what a coach sells. Money is stored in the
/// smallest currency unit (cents) — the same convention Stripe itself uses —
/// to avoid float rounding on prices. Offers are never hard-deleted (only
/// deactivated) because Purchase snapshots reference them for history.
model Offer {
  id                     String           @id @default(cuid())
  coachId                String
  sportId                String?
  name                   String
  description            String?
  type                   OfferType
  priceCents             Int
  currency               String           @default("EUR")
  /// Session credits granted per purchase. Null for a SUBSCRIPTION with no
  /// fixed included-session count.
  sessionCount           Int?
  /// Days after purchase before unused package credits expire. Null = never.
  expirationDays         Int?
  sessionDurationMinutes Int?
  eligibility            OfferEligibility @default(INDIVIDUAL)
  /// Only meaningful for SUBSCRIPTION offers, e.g. "MONTHLY" | "WEEKLY".
  billingFrequency       String?
  active                 Boolean          @default(true)
  /// Cached Stripe Price id, created lazily on first online purchase so an
  /// offer that's never sold online never touches the Stripe API.
  stripePriceId          String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  coach     Coach      @relation(fields: [coachId], references: [id])
  sport     Sport?     @relation(fields: [sportId], references: [id])
  purchases Purchase[]

  @@index([coachId])
}

/// One athlete buying one offer — the credit-granting entity. sessionsPurchased
/// /priceCents/currency are snapshotted from the Offer at purchase time so a
/// later price or offer change never rewrites history.
model Purchase {
  id                String         @id @default(cuid())
  coachId           String
  athleteId         String
  offerId           String
  status            PurchaseStatus @default(PENDING)
  sessionsPurchased Int?
  sessionsUsed      Int            @default(0)
  expiresAt         DateTime?
  priceCents        Int
  currency          String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  coach          Coach           @relation(fields: [coachId], references: [id])
  athlete        Athlete         @relation(fields: [athleteId], references: [id])
  offer          Offer           @relation(fields: [offerId], references: [id])
  payments       Payment[]
  calendarEvents CalendarEvent[]

  @@index([coachId])
  @@index([athleteId])
}

/// A money-movement record against a Purchase. Most purchases have exactly
/// one Payment, but a subscription accrues one per billing period, and a
/// refund is recorded as a status change rather than a new row so the
/// original amount/date stay intact for audit.
model Payment {
  id                      String        @id @default(cuid())
  purchaseId              String
  method                  PaymentMethod
  status                  PaymentStatus @default(PENDING)
  amountCents             Int
  currency                String
  paidAt                  DateTime?
  note                    String?
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  purchase Purchase @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  coachId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  coach Coach? @relation(fields: [coachId], references: [id])

  @@index([name])
  @@index([createdAt])
}
